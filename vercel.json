{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    { "src": "api/index.py", "use": "@vercel/python" }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "api/index.py" }
  ],
  "env": {
    "DEMO_MODE": "true",
    "SEED_DEMO": "1",
    "DATABASE_URL": "sqlite:////tmp/clinic.db"
  }
}
