# Clinic AI Voice Agent — copy to .env and fill ONLY what you have. Never commit .env.
APP_ENV=dev
DEMO_MODE=true
DATABASE_URL=sqlite:///./data/clinic.db
# For production Postgres (Neon): DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
REDIS_URL=
# LLM / STT (Groq) — optional locally, simulated mode is used when empty
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_LLM_MODEL=openai/gpt-oss-120b
# Telephony — pick ONE vendor later; simulated mode is used when empty
TELEPHONY_PROVIDER=simulated
TELEPHONY_API_KEY=
TELEPHONY_API_SECRET=
TELEPHONY_NUMBER=
# WhatsApp Business API (via a BSP) — simulated outbox is used when empty
WHATSAPP_PROVIDER=simulated
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Payments — Cashfree (reuse the user's existing Cashfree app pattern). NOT shown to patients.
PAYMENT_GATEWAY=cashfree
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=SANDBOX
PAYMENT_WEBHOOK_SECRET=
# OTP for clinic-number verification (SMS/WhatsApp provider). Dev mode shows OTP in dashboard/logs only.
OTP_PROVIDER=simulated
OTP_API_KEY=

# CORS — the Vercel frontend origin (comma-separated if more than one).
# Empty = "*" in DEMO_MODE only; set it in prod (Render > Environment).
FRONTEND_ORIGIN=
